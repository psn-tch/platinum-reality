#!/usr/bin/env python3
import json, os, sys, time
here = os.path.dirname(os.path.abspath(__file__))
state_path = os.path.join(here, 'catalog.json')
state = json.load(open(state_path))
with open(os.path.join(here, 'log'), 'a') as log:
    log.write(' '.join(sys.argv[1:]) + '\n')
def say(**message):
    print(json.dumps(message), flush=True)
command, names = sys.argv[1], sys.argv[2:]
if command == 'catalog':
    print(json.dumps(state)); sys.exit(0)
failure = os.path.join(here, 'fail')
if os.path.exists(failure):
    text = open(failure).read()
    os.remove(failure)
    say(**({'cancelled': True} if text == 'cancel' else {'error': text})); sys.exit(1)
pause = os.path.join(here, 'pause')
while os.path.exists(pause):
    time.sleep(0.05)
by_name = {p['name']: p for p in state['packages']}
if command in ('install', 'install-aur'):
    say(progress='resolving dependencies...')
    for i, name in enumerate(names, 1):
        say(step=i, steps=len(names), doing='installing', package=name)
        by_name[name]['installed'] = by_name[name]['version']; by_name[name]['explicit'] = True
        by_name[name].pop('update', None)
    print('==> yay talks directly sometimes', flush=True)
elif command == 'remove':
    for name in names:
        say(step=1, steps=1, doing='removing', package=name)
        by_name[name]['installed'] = ''
elif command == 'update-all':
    for p in state['packages']:
        if p.get('update'):
            say(step=1, steps=1, doing='upgrading', package=p['name'])
            p['installed'] = p['version'] = p.pop('update')
elif command == 'install-yay':
    say(progress='Building yay…'); state['yay'] = True
elif command == 'refresh-aur':
    state['packages'].append({'name': 'aurthing', 'version': '3-1', 'description': 'Something from the AUR',
                              'repo': 'aur', 'installed': '', 'votes': 7, 'orphan': True})
json.dump(state, open(state_path, 'w'))
say(done=True)
