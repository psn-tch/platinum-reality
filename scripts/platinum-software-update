#!/usr/bin/python3 -I
"""Platinum Software Update, the user's side (docs/software-update.md): check GitHub Releases,
download and verify a release, and hand it to the install helper through pkexec. Never runs as
root itself. Every command prints JSON lines.

  status                 the installed version and whether a previous one is kept
  check                  the newest release, verified, and whether it is newer
  download <tag>         fetch that release's package into the cache and verify it
  find                   release folders on mounted disks and in Downloads (Install from Local Package)
  verify <folder>        verify a release folder
  install <folder>       verify, then install through pkexec
  restore                reinstall the previous version through pkexec
"""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import urllib.parse
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parent))
import platinum_update  # noqa: E402

API = 'https://api.github.com/repos/psn-tch/platinum-reality/releases?per_page=10'
# Hosts GitHub serves releases and their assets from; anything else is refused, redirects included.
HOSTS = {'api.github.com', 'github.com', 'objects.githubusercontent.com', 'release-assets.githubusercontent.com'}
HELPER = '/usr/lib/platinum-reality/platinum-update-install'
TIMEOUT = 30


def say(message):
    print(json.dumps(message), flush=True)


class OnlyGitHub(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, url):
        allowed(url)
        return super().redirect_request(request, response, code, message, headers, url)


def allowed(url):
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != 'https' or parts.hostname not in HOSTS:
        raise platinum_update.UpdateError('Software Update only talks to GitHub over HTTPS.')
    return url


OPENER = urllib.request.build_opener(OnlyGitHub())


def fetch(url, target=None, limit=platinum_update.MAX_METADATA, progress=None, accept='application/octet-stream'):
    # The API answers JSON only; release assets are plain downloads.
    request = urllib.request.Request(allowed(url), headers={'User-Agent': 'Platinum-Software-Update',
                                                            'Accept': accept})
    try:
        with OPENER.open(request, timeout=TIMEOUT) as response:
            total = int(response.headers.get('Content-Length') or 0)
            if total > limit:
                raise platinum_update.UpdateError('The download is larger than a release can be.')
            data, got = bytearray(), 0
            output = open(target, 'wb') if target else None
            try:
                for block in iter(lambda: response.read(1 << 16), b''):
                    got += len(block)
                    if got > limit:
                        raise platinum_update.UpdateError('The download is larger than a release can be.')
                    if output:
                        output.write(block)
                    else:
                        data += block
                    if progress:
                        progress(got, total)
            finally:
                if output:
                    output.close()
            return bytes(data)
    except OSError as problem:
        raise platinum_update.UpdateError(f'GitHub could not be reached ({getattr(problem, "reason", problem)}).')


def cache():
    base = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'platinum-update'
    base.mkdir(parents=True, exist_ok=True)
    return base


def keyring(arguments):
    if '--keyring' in arguments:
        index = arguments.index('--keyring')
        path = Path(arguments[index + 1])
        del arguments[index:index + 2]
        return path
    return platinum_update.KEYRING


def releases():
    try:
        listing = json.loads(fetch(API, limit=4 * 1024 * 1024, accept='application/vnd.github+json'))
    except ValueError:
        raise platinum_update.UpdateError('GitHub sent an unreadable list of releases.')
    usable = []
    for release in listing if isinstance(listing, list) else []:
        if release.get('draft') or release.get('prerelease'):
            continue
        assets = {a.get('name'): a.get('browser_download_url') for a in release.get('assets', [])}
        if platinum_update.RELEASE in assets and platinum_update.RELEASE + '.sig' in assets:
            usable.append((str(release.get('tag_name', '')), assets))
    return usable


def folder_for(tag):
    if not tag or '/' in tag or tag.startswith('.'):
        raise platinum_update.UpdateError('That release has an unusable name.')
    return cache() / tag


def describe(release):
    return {key: release[key] for key in ('version', 'date', 'notes', 'size')}


def check(keys):
    installed = platinum_update.installed_version()
    newest = None
    for tag, assets in releases():
        folder = folder_for(tag)
        folder.mkdir(exist_ok=True)
        for name in (platinum_update.RELEASE, platinum_update.RELEASE + '.sig'):
            (folder / name).write_bytes(fetch(assets[name]))
        try:
            release = platinum_update.read_release(folder, keys)
        except platinum_update.UpdateError:
            continue  # Not ours, or damaged: look at the next one.
        if newest is None or platinum_update.vercmp(release['version'], newest[1]['version']) > 0:
            newest = (tag, release, assets)
    if newest is None:
        say({'installed': installed, 'available': None})
        return 0
    tag, release, _ = newest
    if platinum_update.parse_time(release['valid_until']) < platinum_update.datetime.now(platinum_update.timezone.utc):
        raise platinum_update.UpdateError('The newest release description has expired; try again later.')
    newer = installed is None or platinum_update.vercmp(release['version'], installed) > 0
    say({'installed': installed, 'available': dict(describe(release), tag=tag) if newer else None,
         'newest': release['version']})
    return 0


def download(tag, keys):
    folder = folder_for(tag)
    release = platinum_update.read_release(folder, keys)
    assets = dict(releases()).get(tag)
    if not assets or release['package'] not in assets or release['package'] + '.sig' not in assets:
        raise platinum_update.UpdateError('That release has no package to download.')
    fetch(assets[release['package'] + '.sig'], folder / (release['package'] + '.sig'))
    fetch(assets[release['package']], folder / release['package'], platinum_update.MAX_PACKAGE,
          lambda got, total: say({'progress': got, 'total': total or release['size']}) if got % (1 << 22) < (1 << 16) else None)
    return verify(folder, keys)


def verify(folder, keys):
    release, _ = platinum_update.verify_bundle(folder, keys, platinum_update.installed_version())
    say({'ready': str(Path(folder).resolve()), 'release': describe(release)})
    return 0


def find_bundles(roots, depth=3):
    """Folders holding a release.json, newest version first; only their descriptions are read."""
    found = []

    def visit(folder, level):
        try:
            entries = list(folder.iterdir())
        except OSError:
            return
        if any(e.name == platinum_update.RELEASE for e in entries):
            try:
                release = json.loads((folder / platinum_update.RELEASE).read_text()[:platinum_update.MAX_METADATA])
                found.append({'path': str(folder), 'version': str(release.get('version', '?'))})
            except (OSError, ValueError, AttributeError):
                pass
            return
        if level < depth:
            for entry in entries:
                if entry.is_dir() and not entry.is_symlink() and not entry.name.startswith('.'):
                    visit(entry, level + 1)
    for root in roots:
        visit(Path(root), 0)
    return found


def privileged(arguments):
    if not Path(HELPER).is_file() or not shutil.which('pkexec'):
        raise platinum_update.UpdateError('Software Update can install only on a computer where Platinum Reality '
                                          'itself was installed as a package.')
    process = subprocess.Popen(['pkexec', HELPER, *arguments], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               text=True)
    finished = False
    for line in process.stdout:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        finished = finished or 'done' in message or 'error' in message
        say(message)
    code = process.wait()
    problem = process.stderr.read()
    if code in (126, 127) and not finished:
        # With no authentication agent pkexec cannot ask at all (Lily Hewitt, update 43).
        if 'authentication agent' in problem.lower():
            say({'error': 'No password window could be shown. Log out and back in, then try again '
                          '(Platinum Reality starts one at login), or install polkit-kde-agent.'})
        else:
            say({'error': 'Installation was cancelled.' if code == 126 else 'The administrator password was not accepted.'})
    return code


def main(arguments):
    keys = keyring(arguments)
    command, rest = (arguments[0], arguments[1:]) if arguments else ('', [])
    try:
        if command == 'status':
            previous = Path('/var/cache/platinum-update/previous')
            say({'installed': platinum_update.installed_version(),
                 'previous': platinum_update.kept_package(previous) is not None if previous.is_dir() else False})
            return 0
        if command == 'find' and not rest:
            user = os.environ.get('USER', '')
            roots = [Path(p) for p in (f'/run/media/{user}', '/media', '/mnt', Path.home() / 'Downloads')
                     if Path(p).is_dir()]
            say({'bundles': find_bundles(roots)})
            return 0
        if command == 'check' and not rest:
            return check(keys)
        if command == 'download' and len(rest) == 1:
            return download(rest[0], keys)
        if command == 'verify' and len(rest) == 1:
            return verify(Path(rest[0]), keys)
        if command == 'install' and len(rest) == 1:
            verify(Path(rest[0]), keys)
            return privileged([str(Path(rest[0]).resolve())])
        if command == 'restore' and not rest:
            return privileged(['--restore-previous'])
    except platinum_update.UpdateError as problem:
        say({'error': str(problem)})
        return 1
    say({'error': 'Unknown command. ' + __doc__.split('\n\n')[1].strip()})
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
