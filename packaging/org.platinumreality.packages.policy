<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The App Store installs, removes and updates software through this one helper only
     (docs/app-store.md). The password is remembered for a few minutes, so installing yay
     (its tools, then yay itself) asks once. -->
<policyconfig>
  <vendor>Platinum Reality</vendor>
  <vendor_url>https://github.com/psn-tch/platinum-reality</vendor_url>
  <action id="org.platinumreality.packages.manage">
    <description>Install or remove software</description>
    <message>The App Store needs an administrator's password to change the software on this computer.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/platinum-reality/platinum-packages-admin</annotate>
  </action>
</policyconfig>
