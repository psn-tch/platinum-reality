+    /// Platinum Dreams: remember a mapped toplevel's ignored move request (see WindowData).
+    pub fn note_requested_position(&mut self, window: x::Window, x: Option<i16>, y: Option<i16>) {
+        let Some(mut win) = self
+            .windows
+            .get(&window)
+            .copied()
+            .and_then(|id| self.world.get::<&mut WindowData>(id).ok())
+        else {
+            return;
+        };
+        let (old_x, old_y) = win
+            .requested_position
+            .unwrap_or((win.attrs.dims.x, win.attrs.dims.y));
+        win.requested_position = Some((x.unwrap_or(old_x), y.unwrap_or(old_y)));
+    }
+
+    /// Platinum Dreams: the monitor an X11 window means when it asks for fullscreen, from the
+    /// centre of its requested (or current) X11 geometry. X11 programs pick a monitor by moving
+    /// their window onto it; xdg_toplevel.set_fullscreen(None) would leave the choice to the
+    /// compositor, which does not know X11 positions.
+    fn fullscreen_output(&self, win: &WindowData) -> Option<client::wl_output::WlOutput> {
+        let (x, y) = win
+            .requested_position
+            .unwrap_or((win.attrs.dims.x, win.attrs.dims.y));
+        let centre_x = x as i32 + win.attrs.dims.width as i32 / 2;
+        let centre_y = y as i32 + win.attrs.dims.height as i32 / 2;
+        let mut query = self
+            .world
+            .query::<(&client::wl_output::WlOutput, &OutputDimensions)>();
+        query
+            .iter()
+            .find(|(_, (_, d))| {
+                d.width > 0
+                    && d.height > 0
+                    && centre_x >= d.x
+                    && centre_x < d.x + d.width
+                    && centre_y >= d.y
+                    && centre_y < d.y + d.height
+            })
+            .map(|(_, (output, _))| output.clone())
+    }
