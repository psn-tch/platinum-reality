<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Platinum Software Update installs verified releases through this one helper only
     (docs/software-update.md). An administrator's password is asked each time. -->
<policyconfig>
  <vendor>Platinum Reality</vendor>
  <vendor_url>https://github.com/psn-tch/platinum-reality</vendor_url>
  <action id="org.platinumreality.update.install">
    <description>Install a Platinum Reality update</description>
    <message>Software Update needs an administrator's password to install Platinum Reality.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/platinum-reality/platinum-update-install</annotate>
  </action>
</policyconfig>
